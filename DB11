/*
Problem: Sales Person
LeetCode #607

Find the names of all salespersons who did not have
any orders related to the company named "RED".

Approach:
NOT IN + Subquery

1. Find salespersons who have placed orders with RED.
2. Exclude those salespersons from the SalesPerson table.
3. Return the remaining salesperson names.
*/

SELECT name
FROM SalesPerson
WHERE sales_id NOT IN (
    SELECT o.sales_id
    FROM Orders o
    JOIN Company c
        ON o.com_id = c.com_id
    WHERE c.name = 'RED'
);
